import java.util.Scanner;
class fact1 
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.println("Enter a Number to Factorial of it");
		int num=sc.nextInt();
		int fact=1;
		for (int i=1;i<=num ;i++ )
		{
			fact*=i;
		}
		System.out.println("the factorialof "+num+" is "+fact);
	}
}
