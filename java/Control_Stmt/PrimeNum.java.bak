import java.util.*;
class PrimeNum 
{
	static Scanner sc=new Scanner(System.in);
	static boolean b=true;
	public static void main(String[] args) 
	{
		System.out.println("enter a number");
		int num=sc.nextInt();
		if (num==0||num==1)
		{
			System.out.println("It is Not A Prime Number And Also A compund Number");
		}
		else
		{
			for (int i=2;i<num ;i++ )
			{
				if (num%i==0)
				{
					b=false;
					break;
				}
			}
			if (b)
			{
				System.out.println("Prime");
			}
			else
			{
				System.out.println("Not a Prime");
			}
		}
	}
}
