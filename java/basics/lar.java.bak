
import java.util.*;
class Lar
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[] args) 
	{
		int count=1;
		while (count<=2)
		{
			System.out.println("enter a number a");
			int a=sc.nextInt();
			System.out.println("enter a number b");
			int b=sc.nextInt();
			int lar=(a>b)?a:b;
			System.out.println(lar);
		}
		
	}
}