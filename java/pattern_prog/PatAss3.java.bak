class PatAss3
{
	public static void main(String[] args) throws Exception
	{
		int n=7,count=0;
		char ch='A';
		for (int i=0;i<n ;i++ )
		{
			for (int j=1;j<=n ;j++ )
			{
				if (i%2==0)
				{
					if (i==n-n||i==n-9||i==n-5||i==n-1)
					{
						System.out.print(ch++ +" ");
					}
					else
					{
						System.out.print(--ch +" ");
					}

				}
				else
				{
					Thread.sleep(500);
					System.out.print(j +" ");
				}
			}
			System.out.println();
		}
	}
}
