class PatLove
{
	public static void main(String[] args) throws Exception
	{
		int n=5;
		for (int i=0;i<n ;i++ )
		{
			for (int j=0;j<n ;j++ )
			{
				if (i==0&&j==1||i==0&&j==3||i==1&&j==0||i==1&&j==2||i==1&&j==4||i==2&&j==0||i==2&&j==4||i==3&&j==1||i==3&&j==3||i==4&&j==2)
				{
					Thread.sleep(150);
					System.out.print("*    ");
				}
				else
				{
					Thread.sleep(100);
					System.out.print("     ");
				}
			}
			Thread.sleep(150);
			System.out.println();
		}
	}
}
